.manage-page { padding: 24rpx; min-height: 100vh; }
.section { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 16rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: 600; }
.section-edit { font-size: 26rpx; color: #4C6FFF; }

.invite-code-box { display: flex; align-items: center; justify-content: space-between; }
.invite-code { font-size: 48rpx; font-weight: 700; letter-spacing: 16rpx; color: #4C6FFF; }
.invite-actions { display: flex; gap: 12rpx; }
.invite-btn { padding: 12rpx 24rpx; background: #F1F3F5; border-radius: 999rpx; font-size: 24rpx; color: #4C6FFF; }

.info-row { display: flex; padding: 16rpx 0; border-bottom: 2rpx solid #F1F3F5; }
.info-row:last-child { border-bottom: none; }
.info-label { width: 120rpx; font-size: 26rpx; color: #8E8E93; }
.info-value { flex: 1; font-size: 28rpx; }

.member-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #F1F3F5; }
.member-item:last-child { border-bottom: none; }
.member-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; margin-right: 16rpx; }
.member-info { flex: 1; }
.member-name { font-size: 28rpx; }
.member-role { font-size: 22rpx; color: #8E8E93; margin-left: 12rpx; }
.member-remove { font-size: 24rpx; color: #FF3B30; padding: 8rpx 20rpx; }

.actions-section { padding: 0; }
.action-row { display: flex; justify-content: space-between; align-items: center; padding: 28rpx; border-bottom: 2rpx solid #F1F3F5; font-size: 30rpx; }
.action-row:last-child { border-bottom: none; }
.action-row.danger { color: #FF3B30; }
.arrow { color: #C7C7CC; }

.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999; }
.modal { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 600rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; display: block; margin-bottom: 24rpx; }
.form-input { background: #F1F3F5; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; margin-bottom: 12rpx; }
.transfer-list { max-height: 400rpx; overflow-y: auto; margin-bottom: 16rpx; }
.transfer-item { display: flex; align-items: center; padding: 20rpx; border-radius: 12rpx; margin-bottom: 8rpx; }
.transfer-item.selected { background: #F0F4FF; }
.member-avatar-sm { width: 48rpx; height: 48rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22rpx; margin-right: 12rpx; }
.modal-actions { display: flex; gap: 20rpx; }
.modal-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 12rpx; font-size: 30rpx; }
.modal-btn.cancel { background: #F1F3F5; color: #8E8E93; }
.modal-btn.confirm { background: #4C6FFF; color: #fff; }
