.home-page { padding: 24rpx; min-height: 100vh; }
.home-header { padding: 20rpx 0 28rpx; }
.home-title { font-size: 40rpx; font-weight: 700; }
.home-empty { padding: 120rpx 0; }

.class-list { margin-bottom: 140rpx; }
.class-card { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.class-card-left { margin-right: 20rpx; }
.class-badge { width: 80rpx; height: 80rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 36rpx; font-weight: 600; }
.class-card-body { flex: 1; }
.class-name { font-size: 32rpx; font-weight: 600; display: block; }
.class-desc { font-size: 24rpx; color: #8E8E93; display: block; margin-top: 4rpx; }
.class-meta { font-size: 24rpx; color: #8E8E93; margin-top: 8rpx; }
.class-role { font-size: 22rpx; color: #8E8E93; background: #F1F3F5; padding: 6rpx 16rpx; border-radius: 999rpx; }

.home-actions { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; padding: 20rpx 24rpx; background: rgba(241,243,245,0.95); backdrop-filter: blur(10px); }
.action-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 999rpx; font-size: 30rpx; }
.action-btn.primary { background: #4C6FFF; color: #fff; }
.action-btn.secondary { background: #fff; color: #4C6FFF; border: 2rpx solid #4C6FFF; }

.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999; }
.modal { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 600rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; display: block; margin-bottom: 24rpx; }
.form-input { background: #F1F3F5; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; margin-bottom: 12rpx; }
.invite-input { text-align: center; font-size: 40rpx; letter-spacing: 16rpx; }
.form-error { font-size: 24rpx; color: #FF3B30; display: block; margin-bottom: 12rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 16rpx; }
.modal-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 12rpx; font-size: 30rpx; }
.modal-btn.cancel { background: #F1F3F5; color: #8E8E93; }
.modal-btn.confirm { background: #4C6FFF; color: #fff; }
