.login-page { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 40rpx; }
.login-logo { font-size: 120rpx; margin-bottom: 24rpx; }
.login-title { font-size: 48rpx; font-weight: 700; margin-bottom: 12rpx; }
.login-subtitle { font-size: 28rpx; color: #8E8E93; margin-bottom: 80rpx; }
.login-btn { width: 80%; background: #4C6FFF; color: #fff; border-radius: 999rpx; font-size: 32rpx; height: 88rpx; line-height: 88rpx; }
.login-btn[loading] { opacity: 0.7; }
.login-tip { font-size: 24rpx; color: #C7C7CC; margin-top: 24rpx; }
