.dialog-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999; }
.dialog { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 560rpx; }
.dialog-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 16rpx; }
.dialog-content { font-size: 28rpx; color: #8E8E93; display: block; margin-bottom: 32rpx; }
.dialog-actions { display: flex; gap: 20rpx; }
.dialog-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 12rpx; font-size: 30rpx; }
.dialog-btn.cancel { background: #F1F3F5; color: #8E8E93; }
.dialog-btn.confirm { background: #4C6FFF; color: #fff; }
